# Google Authentication Client IDs for Expo
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Public mobile setting only. This is not a secret.
# Use a reachable HTTPS URL in production, or your computer's LAN IP for a physical-device dev build.
EXPO_PUBLIC_IDALI_API_URL=http://192.168.1.10:3000

# Cloudinary Public Configuration
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=xrkw0bpu
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=IDali_mobile

